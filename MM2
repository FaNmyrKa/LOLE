-- =============================================================================
-- farm loop — fly to nearest coin, hover overlapping it until the server collects it.
-- =============================================================================
task.spawn(function()
	while not state.unloaded do
		task.wait()
		if Options.AutoFarm.Value and state.roundActive and not state.bagFull and not isLocalDead() then
			local cc = getCoinContainer()
			local hrp = getHRP()
			if cc and hrp then
				local role = getLocalRole()
				local avoidMurder = Options.AvoidMurderWhileFarming.Value and role ~= "Murderer"
				local mPos = avoidMurder and getMurdererRootPosition() or nil
				local coinId = getEffectiveCoinId(cc)
				state.activeFarmCoinId = coinId
				local coin = select(
					1,
					findNearestCoin(cc, coinId, hrp.Position, mPos, Options.MurderAvoidStuds.Value, avoidMurder)
				)
				if coin then
					local coinPos = coin.Position
					-- 20s @ ≤20 studs/s reaches the ~nearest coin; farm speed follows the (now stealthy) FlySpeed slider
					flyTo(coinPos + Vector3.new(0, 2, 0), MAX_FARM_MOVE_STUDS, { stopDist = 2.5, timeout = 20 })
					-- overlap the coin so the server-side Touched fires
					local start = os.clock()
					while coin.Parent and coin:FindFirstChild("TouchInterest") and not state.unloaded do
						if os.clock() - start > 4 then
							break
						end
						local h = getHRP()
						if h then
							holdAt(h, coinPos)
							h.AssemblyLinearVelocity = Vector3.zero
							-- prime the pickup while overlapping the coin (deterministic, no waiting on physics)
							if firetouchinterest then
								pcall(function()
									firetouchinterest(h, coin, 0)
									firetouchinterest(h, coin, 1)
								end)
							end
						end
						task.wait(0.06)
					end
				else
					task.wait(0.2)
				end
			end
		end
	end
end)

-- =============================================================================
-- Combat loop:
--   Murderer        → (after banking coins, if enabled) hunt nearest player & stab/throw.
--   Sheriff / Hero  → fly to the murderer & shoot.
--   Innocent        → grab a dropped gun (then becomes a shooter), else survive.
-- =============================================================================
task.spawn(function()
	while not state.unloaded do
		task.wait(0.32)
		if Options.AutoCombatAfterFullBag.Value and isInActiveRoundMap() and not isLocalDead() then
			local hum = getHumanoid()
			if hum and hum.Health > 0 then
				local role = getLocalRole()
				if role == "Murderer" then
					if state.bagFull or not Options.MurdererWaitFullBag.Value then
						local victim = nearestEnemyForMurderer()
						if victim and victim.Character then
							if Options.UseKnifeThrow.Value then
								throwKnifeAtChar(victim.Character)
							end
							stabTowardsTarget(victim.Character)
						end
					end
				elseif shouldShootMurderer() then
					shootAtMurderer()
				else
					tryInnocentGrabGunDropThrottled()
					if state.bagFull and not findGunDropBasePart() and not localHasGunReady() then
						runInnocentFullBagSurvival()
					end
				end
			end
		end
	end
end)

