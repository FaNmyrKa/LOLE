-- =============================================================================
-- optional remotes (Inventory / Shop) — resolved lazily & cached, so a missing folder can't
-- error at load and we don't re-walk the tree on every call.
-- =============================================================================
local remoteCache = {}
local function resolveRemote(pathParts, className)
	local key = table.concat(pathParts, "/")
	local cached = remoteCache[key]
	if cached and cached.Parent then
		return cached
	end
	local node = ReplicatedStorage:FindFirstChild("Remotes")
	for _, part in ipairs(pathParts) do
		node = node and node:FindFirstChild(part)
	end
	if node and (className == nil or node:IsA(className)) then
		remoteCache[key] = node
		return node
	end
	return nil
end

