local MAX_FARM_MOVE_STUDS = 2200
local MAX_UTILITY_TELEPORT_STUDS = 10000
local MAX_INNOCENT_FLEE_STUDS = 12000
-- Бой / подбор пистолета: длинные перелёты к цели (иначе не «долетает» до мардерa/жертвы)
local MAX_COMBAT_APPROACH_STUDS = 20000
local MAX_GUN_DROP_GRAB_STUDS = 20000

local function isFiniteNumber(n)
	return type(n) == "number" and n == n and math.abs(n) < 1e6
end

local function isValidWorldPosition(pos)
	return isFiniteNumber(pos.X) and isFiniteNumber(pos.Y) and isFiniteNumber(pos.Z)
end

local function withinMoveRange(fromPos, toPos, maxStuds)
	if not isValidWorldPosition(fromPos) or not isValidWorldPosition(toPos) then
		return false
	end
	return (toPos - fromPos).Magnitude <= maxStuds
end

-- =============================================================================
-- movement — anti-cheat: NEVER snap the HRP across a large distance in one frame
-- (the game kicks for it). flyTo steps the HRP toward the target a little each frame
-- (speed * dt) and cancels gravity, so velocity stays "normal". Everything flies.
-- =============================================================================
local function cancelFarmTween()
	if state.activeTween then
		state.activeTween:Cancel()
		state.activeTween = nil
	end
end

-- Hard ceiling on per-frame HRP translation. A believable sprint is ~1-2 studs/frame @60fps and
-- our fastest fly (speed 200) is ~3.3/frame — this ceiling stays well under any "teleport" the
-- anti-cheat would flag, yet lets normal flight run full-speed. It only bites on a dt/lag spike,
-- turning what would be a kickable single jump into a slightly slower (but safe) glide. EVERY
-- movement and hold in the script clamps to it, so no code path can ever teleport.
local MAX_STEP_PER_FRAME = 8

-- Glue the HRP to pos without ever jumping more than the per-frame cap. Used for the coin-overlap
-- and gun-drop holds, which run right after we've already flown adjacent to the target (so the
-- clamp is a safety net: normally dist < cap and it reaches in one step).
local function holdAt(hrp, pos)
	if not hrp then
		return
	end
	local to = pos - hrp.Position
	local dist = to.Magnitude
	if dist > 1e-3 then
		hrp.CFrame = CFrame.new(hrp.Position + to.Unit * math.min(dist, MAX_STEP_PER_FRAME))
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
end

-- opts: { speed, stopDist, timeout, facePos }
local function flyTo(targetPos, maxMoveStuds, opts)
	opts = opts or {}
	maxMoveStuds = maxMoveStuds or MAX_FARM_MOVE_STUDS
	cancelFarmTween()
	local hrp = getHRP()
	if not hrp or not isValidWorldPosition(targetPos) then
		return false
	end
	if not withinMoveRange(hrp.Position, targetPos, maxMoveStuds) then
		return false
	end
	local speed = math.clamp(opts.speed or state.flySpeed or 15, 8, 400)
	local stopDist = opts.stopDist or 3.5
	-- distance-aware timeout: at a slow (stealthy) flySpeed a far target must still have time to
	-- arrive, so scale by travel time when the caller didn't pin an explicit timeout.
	local timeout = opts.timeout or math.clamp((targetPos - hrp.Position).Magnitude / speed + 4, 8, 45)
	local facePos = opts.facePos
	local t0 = os.clock()
	while not state.unloaded do
		hrp = getHRP()
		local hum = getHumanoid()
		if not hrp or not hum or hum.Health <= 0 then
			return false
		end
		local cur = hrp.Position
		local to = targetPos - cur
		local dist = to.Magnitude
		if dist <= stopDist then
			break
		end
		if os.clock() - t0 > timeout then
			break
		end
		local dt = RunService.Heartbeat:Wait()
		-- ease-out: glide to a gentle stop over the last ~10 studs (smooth arrival, not a hard halt)
		local desired = speed
		if dist < 10 then
			desired = math.max(12, speed * dist / 10)
		end
		-- clamp the per-frame move three ways: desired speed, remaining distance, and the hard
		-- MAX_STEP_PER_FRAME ceiling — so a dt/lag spike can never produce a kickable single jump.
		local step = math.min(desired * math.min(dt, 0.1), dist, MAX_STEP_PER_FRAME)
		local dir = to.Unit
		local nextPos = cur + dir * step
		local lookAt = facePos or (nextPos + Vector3.new(dir.X, 0, dir.Z))
		hrp.CFrame = CFrame.new(nextPos, lookAt)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	hrp = getHRP()
	if hrp and facePos and isValidWorldPosition(facePos) then
		-- rotate to face the target (no translation → no teleport flag)
		hrp.CFrame = CFrame.new(hrp.Position, facePos)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	return hrp ~= nil
end

-- back-compat wrapper: everything that used to teleport now flies (speed nil → uses FlySpeed).
local function teleportHRPTo(targetCF, maxMoveStuds, speed)
	return flyTo(targetCF.Position, maxMoveStuds, { speed = speed })
end

local function teleportAbove(cf)
	return cf * CFrame.new(0, 3, 0)
end

