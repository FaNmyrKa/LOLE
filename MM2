-- =============================================================================
-- server-hop — jump to a random non-full server of this place (QoL for empty servers).
-- Uses the executor's HTTP request fn (request / http_request / syn.request), never a remote.
-- =============================================================================
local function execHttp(opts)
	local fn = (syn and syn.request) or (http and http.request) or http_request or request
	if type(fn) ~= "function" then
		return nil
	end
	local ok, res = pcall(fn, opts)
	if ok and type(res) == "table" then
		return res
	end
	return nil
end

local function serverHop()
	return pcall(function()
		local url = string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true",
			game.PlaceId
		)
		local res = execHttp({ Url = url, Method = "GET" })
		local body = res and (res.Body or res.body)
		if not body then
			error("no http response")
		end
		local data = game:GetService("HttpService"):JSONDecode(body)
		if type(data) ~= "table" or type(data.data) ~= "table" then
			error("bad server list")
		end
		local candidates = {}
		for _, s in ipairs(data.data) do
			if type(s) == "table" and tonumber(s.playing) and tonumber(s.maxPlayers)
				and s.playing < s.maxPlayers and s.id ~= game.JobId then
				candidates[#candidates + 1] = s.id
			end
		end
		if #candidates == 0 then
			error("no open server")
		end
		local target = candidates[math.random(1, #candidates)]
		game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, target, LocalPlayer)
	end)
end

