	local ok, res = pcall(require, mod)
	if ok and type(res) == "table" then
		return res
	end
	return nil
end

local function listCrateNames()
	local names = {}
	local db = getMysteryBoxDB()
	if db then
		for k in pairs(db) do
			names[#names + 1] = tostring(k)
		end
		table.sort(names)
	end
	if #names == 0 then
		names = { "MysteryBox1" }
	end
	return names
end

-- crateType arg for OpenCrate: prefer an explicit field on the DB entry, else strip trailing
-- digits ("MysteryBox1" → "MysteryBox"), else a safe default. A wrong type just no-ops server-side.
local function crateTypeFor(crateName)
	local db = getMysteryBoxDB()
	local e = db and db[crateName]
	if type(e) == "table" then
		local t = e.Type or e.CrateType or e.Category or e.Kind
		if type(t) == "string" and t ~= "" then
			return t
		end
	end
	local base = tostring(crateName):gsub("%d+$", "")
	if base ~= "" then
		return base
	end
	return "MysteryBox"
end

