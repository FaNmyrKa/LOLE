-- =============================================================================
-- Starlight UI — value-store shim + element helpers (Options must exist before ESP / loops)
-- =============================================================================
-- We keep our OWN `Options` table (Value / OnChanged / Set / SetValue / SetValues per key) so all
-- the game logic that reads `Options.X.Value` stays identical regardless of the UI lib. The add*
-- helpers build native Starlight elements whose callbacks write back into this store.
local Options = {}

local OPT_STUB = { Value = nil }
function OPT_STUB:OnChanged()
	return self
end
function OPT_STUB:Set() end
function OPT_STUB:SetValue() end
function OPT_STUB:SetValues() end
-- reading a not-yet-created option key never crashes a loop: it yields an inert stub (Value = nil)
setmetatable(Options, {
	__index = function()
		return OPT_STUB
	end,
})

local function ensureOpt(key, default)
	local o = rawget(Options, key)
	if o then
		o.Value = default
		return o
	end
	o = { Value = default, _subs = {}, _dd = nil }
	function o:OnChanged(fn)
		table.insert(self._subs, fn)
		return self
	end
	function o:_fire()
		for _, fn in ipairs(self._subs) do
			pcall(fn, self.Value)
		end
	end
	function o:Set(v)
		self.Value = v
		self:_fire()
	end
	function o:SetValue(v)
		self.Value = v
		if self._dd then
			pcall(function()
				self._dd:Set({ CurrentOptions = { v } })
			end)
		end
		self:_fire()
	end
	function o:SetValues(list)
		if self._dd then
			pcall(function()
				self._dd:Set({ Options = list })
			end)
		end
	end
	rawset(Options, key, o)
	return o
end

-- unique element indices for non-persistent elements (buttons/labels/paragraphs)
local uidN = 0
local function uid(prefix)
	uidN = uidN + 1
	return (prefix or "el") .. uidN
end

-- Starlight dropdown callbacks hand back a table of selected options; reduce to one string.
local function firstSelected(sel)
	if type(sel) == "string" then
		return sel
	end
	if type(sel) == "table" then
		if sel[1] ~= nil then
			return sel[1]
		end
		for k, v in pairs(sel) do
			if v then
				return k
			end
		end
	end
	return nil
end

-- NebulaIcons is optional: a bad name or a failed load just yields no icon (never an error).
local function icon(name, lib)
	if not NebulaIcons then
		return nil
	end
	local ok, res = pcall(function()
		return NebulaIcons:GetIcon(name, lib or "Lucide")
	end)
	if ok then
		return res
	end
	return nil
end

local notifN = 0
local function notify(o)
	notifN = notifN + 1
	pcall(function()
		-- Duration intentionally omitted: Starlight's docs don't state the unit (ms vs s), and a
		-- wrong guess makes toasts permanent. With no Duration it auto-sizes read-time by content.
		Starlight:Notification({
			Title = o.Title,
			Content = o.Content,
		}, "notif_" .. notifN)
	end)
end

local function addToggle(gb, key, o)
	local default = o.Default == true
	ensureOpt(key, default)
	gb:CreateToggle({
		Name = o.Title,
		Tooltip = o.Description,
		CurrentValue = default,
		IgnoreConfig = o.IgnoreConfig,
		Callback = function(v)
			Options[key]:Set(v and true or false)
		end,
	}, key)
end

local function addSlider(gb, key, o)
	local default = o.Default or o.Min or 0
	ensureOpt(key, default)
	local increment = (o.Rounding and o.Rounding > 0) and (1 / (10 ^ o.Rounding)) or 1
	gb:CreateSlider({
		Name = o.Title,
		Tooltip = o.Description,
		Range = { o.Min or 0, o.Max or 100 },
		Increment = increment,
		Suffix = o.Suffix,
		CurrentValue = default,
		Callback = function(v)
			Options[key]:Set(tonumber(v) or default)
		end,
	}, key)
end

local function addButton(gb, o)
	gb:CreateButton({
		Name = o.Title,
		Tooltip = o.Description,
		Callback = o.Callback,
	}, uid("btn"))
end

local function addDropdown(gb, key, o)
	local values = o.Values or {}
	local default = o.Default
	if type(default) == "number" then
		default = values[default]
	end
	ensureOpt(key, default)
	-- dropdowns are nested under a label in Starlight
	local label = gb:CreateLabel({ Name = o.Title, Tooltip = o.Description }, uid("lbl"))
	local dd = label:AddDropdown({
		Options = values,
		CurrentOptions = default ~= nil and { default } or {},
		Placeholder = "Select…",
		MultipleOptions = false,
		Callback = function(sel)
			local v = firstSelected(sel)
			if v ~= nil then
				Options[key]:Set(v)
			end
		end,
	}, key)
	rawget(Options, key)._dd = dd
end

local function addParagraph(gb, o)
	local p = gb:CreateParagraph({ Name = o.Title or "—", Content = o.Content or "" }, uid("para"))
	local st = { title = o.Title or "—", content = o.Content or "" }
	-- Fluent-style wrapper so the round-timer loop keeps calling :SetDesc / :SetTitle unchanged.
	-- Always re-Set the FULL spec (both fields) so replace-semantics :Set can't blank the other.
	local function apply()
		pcall(function()
			p:Set({ Name = st.title, Content = st.content })
		end)
	end
	return {
		SetDesc = function(_, txt)
			st.content = txt
			apply()
		end,
		SetTitle = function(_, txt)
			st.title = txt
			apply()
		end,
	}
end

