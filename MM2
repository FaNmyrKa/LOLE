local predictAim -- forward decl: aimbot lead-prediction, defined below (used by throw/shoot)

-- Stab kill (live-verified KnifeClient): register the stab (KnifeStabbed, no args), then
-- deliver the handle contact on the victim (HandleTouched, victim part) inside the ~0.85s window.
local function stabTowardsTarget(targetChar)
	local knife, events = getKnifeAndEvents()
	if not knife or not events then
		return false
	end
	local stabRemote = events:FindFirstChild("KnifeStabbed")
	local touchRemote = events:FindFirstChild("HandleTouched")
	local handle = knife:FindFirstChild("Handle")
	if not stabRemote or not touchRemote then
		return false
	end
	local myRoot = getHRP()
	local theirRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not myRoot or not theirRoot then
		return false
	end
	local delta = myRoot.Position - theirRoot.Position
	if delta.Magnitude < 1e-2 then
		delta = Vector3.new(0, 0, 1)
	end
	local approach = theirRoot.Position + delta.Unit * 3
	if not withinMoveRange(myRoot.Position, approach, MAX_COMBAT_APPROACH_STUDS) then
		return false
	end
	flyTo(approach, MAX_COMBAT_APPROACH_STUDS, { stopDist = 2, timeout = 6, facePos = theirRoot.Position })
	stabRemote:FireServer()
	task.wait(0.05)
	local parts = {
		theirRoot,
		targetChar:FindFirstChild("UpperTorso"),
		targetChar:FindFirstChild("Torso"),
		targetChar:FindFirstChild("Head"),
	}
	for _ = 1, 3 do
		for _, part in parts do
			if part then
				-- prime a server-side touch so HandleTouched validates without perfect contact
				if handle and firetouchinterest then
					pcall(function()
						firetouchinterest(handle, part, 0)
						firetouchinterest(handle, part, 1)
					end)
				end
				touchRemote:FireServer(part)
			end
		end
		task.wait(0.04)
	end
	return true
end

-- Ranged kill: throw the knife from the handle toward the victim.
local function throwKnifeAtChar(targetChar)
	local knife, events = getKnifeAndEvents()
	if not knife or not events then
		return false
	end
	local throwRemote = events:FindFirstChild("KnifeThrown")
	local handle = knife:FindFirstChild("Handle")
	local theirRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not throwRemote or not handle or not theirRoot then
		return false
	end
	local aimPos = (state.aimbotEnabled and predictAim(targetChar, state.knifeSpeed)) or theirRoot.Position
	throwRemote:FireServer(handle.CFrame, CFrame.new(aimPos or theirRoot.Position))
	return true
end

local function getGunRaycastOrigin()
	local hrp = getHRP()
	if not hrp then
		return nil
	end
	local att = hrp:FindFirstChild("GunRaycastAttachment")
	if att then
		return att.WorldCFrame
	end
	return hrp.CFrame * CFrame.new(0, 0.5, -1)
end

-- =============================================================================
-- aimbot lead-prediction (ported/condensed from ShadowX; client-only math, no movement,
-- fires through our verified Gun.Shoot / Knife.Events.KnifeThrown remotes).
-- =============================================================================
local function getNetPing()
	local ok, s = pcall(function()
		return LocalPlayer:GetNetworkPing() -- seconds (one-way)
	end)
	if ok and type(s) == "number" then
		return math.clamp(s, 0, 0.4) -- clamp so a lag spike can't throw aim into space
	end
	return 0.08
end

-- Where to aim at targetChar. projectileSpeed (studs/s) => lead by travel time (knife throw);
-- nil => near-hitscan (gun), lead only by network ping. Returns a Vector3 or nil.
predictAim = function(targetChar, projectileSpeed)
	local troot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not troot then
		return nil
	end
	local myRoot = getHRP()
	local aimPart = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or troot
	local basePos = aimPart.Position
	local vel = troot.AssemblyLinearVelocity
	local hVel = Vector3.new(vel.X, 0, vel.Z)
	local t
	if projectileSpeed and projectileSpeed > 0 and myRoot then
		t = (basePos - myRoot.Position).Magnitude / projectileSpeed
	else
		t = getNetPing()
	end
	local pred = basePos
	if hVel.Magnitude >= 2 then -- skip lead for ~stationary targets
		pred = pred + hVel * t
	end
	local hum = targetChar:FindFirstChildOfClass("Humanoid")
	if hum and hum.FloorMaterial == Enum.Material.Air then -- ballistic Y while airborne
		local g = workspace.Gravity
		pred = pred + Vector3.new(0, vel.Y * t - 0.5 * g * t * t, 0)
	end
	-- LOS / wall cap: if a wall sits between us and the lead point, aim at a visible body part
	if myRoot then
		local origin = myRoot.Position
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = { getCharacter(), targetChar }
		local hit = workspace:Raycast(origin, pred - origin, rp)
		if hit and not hit.Instance:IsDescendantOf(targetChar) then
			for _, n in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
				local p = targetChar:FindFirstChild(n)
				if p then
					local h2 = workspace:Raycast(origin, p.Position - origin, rp)
					if not h2 or h2.Instance:IsDescendantOf(targetChar) then
						return p.Position
					end
				end
			end
			return troot.Position
		end
	end
	return pred
end

-- Gun kill (live-verified GunClient): Shoot:FireServer(originCFrame, targetCFrame),
-- origin from HRP.GunRaycastAttachment, target a CFrame at the victim.
local function shootTarget(targetChar)
	local gun = equipTool("Gun")
	if not gun then
		return false
	end
	local shoot = gun:FindFirstChild("Shoot")
	if not shoot or not shoot:IsA("RemoteEvent") then
		return false
	end
	local thum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	local troot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not thum or thum.Health <= 0 or not troot then
		return false
	end
	local myRoot = getHRP()
	if myRoot then
		local shotPos = troot.Position + (myRoot.Position - troot.Position).Unit * 8
		if withinMoveRange(myRoot.Position, shotPos, MAX_COMBAT_APPROACH_STUDS) then
			flyTo(shotPos, MAX_COMBAT_APPROACH_STUDS, { stopDist = 3, timeout = 6, facePos = troot.Position })
		end
	end
	gun = equipTool("Gun") or gun
	shoot = gun:FindFirstChild("Shoot") or shoot
	local fired = false
	for _ = 1, 5 do
		if thum.Health <= 0 then
			break
		end
		local origin = getGunRaycastOrigin()
		if origin then
			local aimPos = (state.aimbotEnabled and predictAim(targetChar, nil)) or (troot.Position + Vector3.new(0, 0.5, 0))
			local aim = CFrame.new(aimPos or troot.Position)
			local ok = pcall(function()
				shoot:FireServer(origin, aim)
			end)
			fired = fired or ok
		end
		task.wait(0.08)
	end
	return fired
end

local function shootAtMurderer()
	local murder = findMurderer()
	if not murder or murder == LocalPlayer then
		return false
	end
	return shootTarget(murder.Character)
end

