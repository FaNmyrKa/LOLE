		state.roundSeconds = readRoundTimer()
		if GetEventsRF then
			local ok, ev = pcall(function()
				return GetEventsRF:InvokeServer()
			end)
			if ok then
				if type(ev) == "table" then
					state.eventName = ev.Name or ev.name or ev.Event or ev.Active or nil
				elseif type(ev) == "string" then
					state.eventName = ev
				end
			end
		end
		if RoundInfoLabel then
			local secs = state.roundSeconds
			local txt = secs and string.format("%dm %02ds", math.floor(secs / 60), secs % 60) or "lobby / —"
			if state.eventName then
				txt = txt .. "   |   event: " .. tostring(state.eventName)
			end
			if isLocalDead() then
				txt = "☠ DEAD (waiting for turn)   |   " .. txt
			end
			pcall(function()
				RoundInfoLabel:SetDesc(txt)
			end)
			pcall(function()
				RoundInfoLabel:SetTitle("Round: " .. txt)
			end)
		end
		task.wait(1)
	end
end)

-- anti-fling: clamp our OWN velocity to a believable cap (self-only, safe)
track(RunService.Heartbeat:Connect(function()
	if state.unloaded or not Options.AntiFling.Value then
		return
	end
	local hrp = getHRP()
	if not hrp then
		return
	end
	local cap = math.max(state.flySpeed + 25, 90)
	local v = hrp.AssemblyLinearVelocity
	if v.Magnitude > cap then
		hrp.AssemblyLinearVelocity = v.Unit * cap
	end
end))

