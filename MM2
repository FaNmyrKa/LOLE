	while not state.unloaded do
		task.wait(0.1)
		if Options.KillAura.Value and isInActiveRoundMap() and getLocalRole() == "Murderer" and not isLocalDead() then
			local hum = getHumanoid()
			local myRoot = getHRP()
			if hum and hum.Health > 0 and myRoot then
				local radius = Options.AuraRadius.Value
				local fov = Options.AuraFOV.Value
				local cosHalf = math.cos(math.rad(fov) / 2)
				local look = myRoot.CFrame.LookVector
				local best, bestD = nil, math.huge
				for _, plr in Players:GetPlayers() do
					if plr ~= LocalPlayer then
						local ch = plr.Character
						local phum = ch and ch:FindFirstChildOfClass("Humanoid")
						local proot = ch and ch:FindFirstChild("HumanoidRootPart")
						if phum and phum.Health > 0 and proot then
							local to = proot.Position - myRoot.Position
							local dist = to.Magnitude
							local inCone = fov >= 360 or (dist > 0 and to.Unit:Dot(look) >= cosHalf)
							if dist <= radius and inCone and dist < bestD then
								best, bestD = ch, dist
							end
						end
					end
				end
				if best then
					stabTowardsTarget(best)
					task.wait(0.08 + math.random() * 0.1) -- jitter between aura hits
				end
			end
		end
	end
end)

