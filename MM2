-- roles — source of truth = server PlayerData (entry.Role). Held tools are unreliable
-- because cosmetic Knife/Gun tools sit in non-murderers' backpacks (live-verified).
-- =============================================================================
local function dataRole(name)
	local e = state.playerData[name]
	if type(e) == "table" then
		return e.Role
	end
	return nil
end

local function findPlayerByRole(roleName)
	for name, entry in pairs(state.playerData) do
		if type(entry) == "table" and entry.Role == roleName then
			local p = Players:FindFirstChild(name)
			if p then
				return p
			end
		end
	end
	return nil
end

local function characterHasTool(plr, toolName)
	local ch = plr.Character
	local t = ch and ch:FindFirstChild(toolName)
	return t ~= nil and t:IsA("Tool")
end

local function findMurderer()
	local p = findPlayerByRole("Murderer")
	if p then
		return p
	end
	-- fallback: a knife actually equipped in a character (not just a cosmetic in backpack)
	for _, plr in Players:GetPlayers() do
		if plr ~= LocalPlayer and characterHasTool(plr, "Knife") then
			return plr
		end
	end
	return nil
end

local function findSheriff()
	local p = findPlayerByRole("Sheriff") or findPlayerByRole("Hero")
	if p then
		return p
	end
	for _, plr in Players:GetPlayers() do
		if plr ~= LocalPlayer and characterHasTool(plr, "Gun") then
			return plr
		end
	end
	return nil
end

local function roleOfPlayer(plr)
	local r = dataRole(plr.Name)
	if r then
		return r
	end
	if plr == findMurderer() then
		return "Murderer"
	end
	if plr == findSheriff() then
		return "Sheriff"
	end
	return "Innocent"
end

local function getLocalRole()
	local r = dataRole(LocalPlayer.Name)
	if r then
		return r
	end
	-- fallback: only trust a tool equipped in our OWN character
	local char = getCharacter()
	if char and char:FindFirstChild("Knife") then
		return "Murderer"
	end
	if char and char:FindFirstChild("Gun") then
		return "Sheriff"
	end
	return "Innocent"
end

local function getMurdererRootPosition()
	local m = findMurderer()
	if not m or m == LocalPlayer then
		return nil
	end
	local ch = m.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position or nil
end

-- =============================================================================
-- death / spectate detection — the "WAITING FOR YOUR TURN" banner means we're out
-- this round. Primary signal = PlayerData.Dead/Killed; banner + health are fallbacks.
-- =============================================================================
local deadBanner -- cached TextLabel (found once by text, then just read Visible)
local lastBannerScan = 0
local function findDeadBanner()
	if deadBanner and deadBanner.Parent then
		return deadBanner
	end
	if os.clock() - lastBannerScan < 2 then -- throttle the descendant scan
		return nil
	end
	lastBannerScan = os.clock()
	deadBanner = nil
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return nil
	end
	for _, d in pg:GetDescendants() do
		if d:IsA("TextLabel") and string.find(string.upper(d.Text or ""), "WAITING FOR YOUR TURN", 1, true) then
			deadBanner = d
			return d
		end
	end
	return nil
end

local function guiChainVisible(inst)
	local node = inst
	while node and node ~= game do
		if node:IsA("GuiObject") and node.Visible == false then
			return false
		end
		if node:IsA("LayerCollector") and node.Enabled == false then
			return false
		end
		node = node.Parent
	end
	return true
end

local function isLocalDead()
	local e = state.playerData[LocalPlayer.Name]
	if type(e) == "table" and (e.Dead == true or e.Killed == true) then
		return true
	end
	local banner = findDeadBanner()
	if banner and guiChainVisible(banner) then
		return true
	end
	local hum = getHumanoid()
	if hum and hum.Health <= 0 then
		return true
	end
	return false
end

