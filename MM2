-- missing Inventory/Shop folder can't error. Crate opening SPENDS coins → manual button + an
-- opt-in toggle only. Sigs came from a leaked MM2 hub; not our-verified — treat fails as no-ops.
-- =============================================================================
local CRATE_CURRENCY = "Coins"

local function getMysteryBoxDB()
	local db = ReplicatedStorage:FindFirstChild("Database")
