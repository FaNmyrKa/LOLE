                pcall(function()
                    unitDropdown:ClearOptions()
                    task.wait(0.05)
                    unitDropdown:InsertOptions(buildUnitOptions(selectedBanner))
                end)
            end
        end,
    })

    local summonToggle
    summonToggle = sections.SummonL:Toggle({
        Name = "Auto Summon",
        Default = false,
        Info = "Stops on a selected unit, on empty currency or on full tower slots",
        Callback = function(state) autoSummon = state end,
    }, "AutoSummon")

    local function stopSummon(reason)
        autoSummon = false
        task.defer(function() pcall(function() summonToggle:UpdateState(false) end) end)
        setSummonStatus(reason)
    end

    -- имена выпавших юнитов из ответа сервера (форма ответа может отличаться — разбираем обе)
    local function pulledNames(res)
        local names = {}
        if type(res) ~= "table" then return names end
        for _, v in pairs(res) do
            if type(v) == "table" then
                local n = v.Name or v.TowerName
                if n then table.insert(names, tostring(n)) end
            elseif type(v) == "string" then
                table.insert(names, v)
            end
        end
        return names
    end

    summonTotal = 0
    task.spawn(function()
        while true do
            -- зависимости валидируем ВНУТРИ цикла, а не в колбэке тоггла
            if getgenv()._running and autoSummon and selectedBanner and R.SummonF then
                local ok = pcall(function()
                    local data = GetPlayerData()
                    local b = summonBanners[selectedBanner]
                    if not data or type(b) ~= "table" then return end

                    local price    = b.SummonPrice or 0
                    local curType  = (b.SummonCurrency and b.SummonCurrency.ItemType) or "Currency"
                    local curName  = (b.SummonCurrency and b.SummonCurrency.ItemName) or "Gems"
                    local have     = (data.Inventory and data.Inventory[curType]
                                      and data.Inventory[curType][curName]) or 0
                    local amount   = summonAmount

                    if have < price * amount then
                        return stopSummon("out of " .. curName .. " (" .. have .. ")")
                    end

                    local owned = 0
                    for _ in pairs((data.Inventory and data.Inventory.Towers) or {}) do owned = owned + 1 end
                    if (data.MaxTowerSlot or 0) < owned + amount then
                        return stopSummon("tower slots full (" .. owned .. "/" .. (data.MaxTowerSlot or 0) .. ")")
                    end

                    local res = R.SummonF:InvokeServer("SummonTower", selectedBanner, amount)
                    local names = pulledNames(res)
                    if #names == 0 then return end
                    summonTotal = summonTotal + #names
                    setSummonStatus(string.format("%d summoned · %s left: %d",
                        summonTotal, curName, have - price * amount))

                    if next(summonTargets) then
                        for _, n in ipairs(names) do
                            if summonTargets[n] then
                                stopSummon("got " .. n .. "!")
                                Notify("Target unit: " .. n)
                                return
                            end
                        end
                    end
                end)
                if not ok then task.wait(1) end
            end
            task.wait(0.6)
        end
    end)

    sections.SummonR:Header({ Text = "Banner info" })
    local infoParagraph = sections.SummonR:Paragraph({ Header = "—", Body = "Pick a banner." })
    task.spawn(function()
        while true do
            task.wait(2)
            local b = selectedBanner and summonBanners[selectedBanner]
            if type(b) == "table" then
                local chances = {}
                for rarity, c in pairs(b.SummonChances or {}) do
                    table.insert(chances, { r = rarity, c = c })
                end
                table.sort(chances, function(x, y)
                    return (RARITY_ORDER[x.r] or 9) < (RARITY_ORDER[y.r] or 9)
                end)
                local lines = {}
                for _, e in ipairs(chances) do
                    table.insert(lines, string.format("%s — %.4f%%", e.r, e.c * 100))
                end
                local pity = {}
                for _, k in ipairs({ "LegendaryPity", "MythicPity", "SecretPity" }) do
                    if b[k] then table.insert(pity, k:gsub("Pity", "") .. " pity: " .. tostring(b[k])) end
                end
                pcall(function()
                    infoParagraph:UpdateHeader(tostring(b.DisplayName or selectedBanner)
                        .. " — " .. tostring(b.SummonPrice) .. " "
                        .. tostring(b.SummonCurrency and b.SummonCurrency.ItemName or ""))
                    infoParagraph:UpdateBody(table.concat(lines, "\n") .. "\n\n" .. table.concat(pity, "\n"))
                end)
            end
        end
    end)
end

-- ===================== REWARDS: собрать всё, что даётся бесплатно =====================
-- Все экшены сняты с клиентских модулей игры (LobbyModules.UIHandler.*), аргументы строятся
-- динамически из профиля игрока — никаких захардкоженных индексов/имён.
local rewardsBusy = false
local rewardsStatus = sections.RewardsR:Label({ Text = "Status: idle" })
local function setRewardsStatus(t) pcall(function() rewardsStatus:UpdateName("Status: " .. t) end) end

local function fire(remote, ...)
    if not remote then return false end
    local args = table.pack(...)
    return (pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end))
end

-- Каждый источник: имя -> функция(data) -> кол-во отправленных запросов
local REWARD_SOURCES = {
    {
        Name = "Quests",
        Run = function(data)
            local n = 0
            if fire(R.Quest, "ClaimAllQuests") then n = n + 1 end
            for key in pairs((data and data.Quests and data.Quests.Permanent) or {}) do
                task.wait(0.15)
                if fire(R.Quest, "ClaimPermanentQuest", key) then n = n + 1 end
            end
            for lineName, line in pairs((data and data.Quests and data.Quests.QuestLines) or {}) do
                if type(line) == "table" then
                    for _, q in pairs(line) do
                        if type(q) == "table" and q.QuestIndex and not q.Claimed then
                            task.wait(0.15)
                            if fire(R.Quest, "ClaimQuestLineQuest", lineName, q.QuestIndex) then n = n + 1 end
                        end
                    end
                end
            end
            return n
        end,
    },
    {
        Name = "Daily Reward",
        Run = function()
            local n = 0
            if fire(R.Event, "ClaimDailyReward", "Normal") then n = n + 1 end
            -- Upgraded-трек только для Roblox Premium, сервер сам отсеет остальных
            if LocalPlayer.MembershipType == Enum.MembershipType.Premium then
                task.wait(0.2)
                if fire(R.Event, "ClaimDailyReward", "Upgraded") then n = n + 1 end
            end
            return n
        end,
    },
    {
        Name = "Daily Wheel",
        Run = function()
            if not R.Wheel then return 0 end
            local ok = pcall(function() return R.Wheel:InvokeServer(true) end)   -- true = бесплатный спин
            return ok and 1 or 0
        end,
    },
    {
        Name = "Playtime",
        Run = function(data)
            local claimed = (data and data.PlayTimeRewards and data.PlayTimeRewards.Claimed) or {}
            local n = 0
            for i = 1, 12 do
                if not (claimed[i] or claimed[tostring(i)]) then
                    if fire(R.PlayTime, "ClaimPlayTimeReward", i) then n = n + 1 end
                    task.wait(0.15)
                end
            end
            return n
        end,
    },
    {
        Name = "Battlepass",
        Run = function(data)
            local n = 0
            for season in pairs((data and data.Battlepasses) or {}) do
                if fire(R.Battlepass, "ClaimBattlepass", season) then n = n + 1 end
                task.wait(0.15)
            end
            return n
        end,
    },
    {
        Name = "Level Milestones",
        Run = function() return fire(R.Event, "ClaimLevelMilestone") and 1 or 0 end,
    },
    {
        Name = "Group Reward",
        Run = function() return fire(R.Event, "ClaimGroupReward") and 1 or 0 end,
    },
    {
        Name = "Tower Index",
        Run = function(data)
            if not (data and CalcStuff and R.Inventory) then return 0 end
            -- сервер требует уровень CalculateStuff.RequiredTowerIndexLevel
            local lvl = CalcStuff.GetPlayerLevelFromExp and CalcStuff.GetPlayerLevelFromExp(data.Exp or 0) or 0
            if CalcStuff.RequiredTowerIndexLevel and lvl < CalcStuff.RequiredTowerIndexLevel then
                return 0
            end
            local n = 0
            -- 1) награда за каждую открытую башню (батч-форма, как у кнопки Claim All в игре)
            local towers = {}
            for name in pairs(data.TowerIndex or {}) do table.insert(towers, name) end
            if #towers > 0 and fire(R.Inventory, "ClaimIndexReward", towers) then n = n + 1 end
            -- 2) майлстоуны коллекции — повторяем логику игры один в один
            local milestones = {}
            local claimedMs = data.TowerIndexMilestones or {}
            for _, rarity in pairs(CalcStuff.TowerRarities or {}) do
                local tiers = CalcStuff.IndexCollectionMilestone and CalcStuff.IndexCollectionMilestone[rarity]
                if tiers then
                    local discovered = (CalcStuff.CountDiscoveredTowers
                        and CalcStuff.CountDiscoveredTowers(data.TowerIndex or {}, rarity)) or 0
                    for count in pairs(tiers) do
                        if not claimedMs[rarity .. "." .. tostring(count)] and count <= discovered then
                            table.insert(milestones, { Rarity = rarity, Count = count })
                        end
                    end
                end
            end
            if #milestones > 0 then
                task.wait(0.2)
                if fire(R.Inventory, "ClaimIndexMilestoneReward", milestones) then n = n + 1 end
            end
            return n
        end,
    },
    {
        Name = "Rank Rewards",
        Run = function() return fire(R.Misc, "ClaimRankRewards", "InfinityCastle") and 1 or 0 end,
    },
}

selectedRewardSources = {}
for _, s in ipairs(REWARD_SOURCES) do selectedRewardSources[s.Name] = true end

local function claimAllRewards(silent)
    if rewardsBusy or not ModulesLoaded then return end
    rewardsBusy = true
    local data = GetPlayerData()
    local total, used = 0, {}
    for _, src in ipairs(REWARD_SOURCES) do
        if not getgenv()._running then break end
        if selectedRewardSources[src.Name] then
            setRewardsStatus("claiming " .. src.Name .. "...")
            local ok, n = pcall(src.Run, data)
            if ok and type(n) == "number" and n > 0 then
                total = total + n
                table.insert(used, src.Name)
            end
            task.wait(0.35)
        end
    end
    setRewardsStatus(string.format("sent %d claim(s) across %d source(s)", total, #used))
    if not silent then Notify(string.format("Rewards: %d claims sent (%s)", total,
        #used > 0 and table.concat(used, ", ") or "nothing to claim")) end
    rewardsBusy = false
end

