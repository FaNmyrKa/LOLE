local function loadMacLib()
    local SOURCES = {
        "http://localhost:8081/MacLib.lua",                                        -- локальный дев-сервер
        "https://raw.githubusercontent.com/dvorfkar6-lab/uis/refs/heads/main/Mac", -- прод (github)
    }
    for _, url in ipairs(SOURCES) do
        local ok, src = pcall(function() return game:HttpGet(url) end)
        if ok and type(src) == "string" and #src > 100 then
            local chunk = loadstring(src)
            if chunk then
                local okRun, lib = pcall(chunk)
                if okRun and type(lib) == "table" then return lib end
            end
        end
    end
    error("Apel Hub: не удалось загрузить MacLib (localhost и github недоступны)")
end
