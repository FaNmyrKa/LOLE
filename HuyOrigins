local CODE_COOLDOWN = 3.4   -- серверный анти-спам ~3 c между любыми попытками (замерено)
local codesBusy = false

-- Уже отредименные коды лежат в профиле игрока: PlayerData.RedeemedCodes.
-- ВАЖНО: клиентский кэш GlobalTables.PlayerData сервер после редима НЕ обновляет (ChangeData не шлёт),
-- поэтому источник правды — свежий InvokeServer("GetPlayerData"); кэш только как фолбэк.
local function getRedeemedSet()
    local set = {}
    local data = GetPlayerData()
    if type(data) ~= "table" or type(data.RedeemedCodes) ~= "table" then
        pcall(function()
            local GlobalTables = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GlobalTables"))
            data = GlobalTables and GlobalTables.PlayerData
        end)
    end
    if type(data) == "table" and type(data.RedeemedCodes) == "table" then
        for _, c in pairs(data.RedeemedCodes) do set[tostring(c)] = true end
    end
    return set
end

-- Возвращает: "redeemed" | "already" | "invalid" | "failed"
local function redeemOne(code)
    for attempt = 1, 5 do
        if not getgenv()._running then return "failed" end
        local ok, msg, success = pcall(function() return CodesRF:InvokeServer("RedeemCode", code) end)
        if ok then
            msg = tostring(msg)
            if success == true or (msg:find("Redeemed!") and not msg:find("Already")) then
                return "redeemed"
            elseif msg:find("Already") then
                return "already"
            elseif msg:find("Try again") then
                task.wait(CODE_COOLDOWN)   -- попали в анти-спам — ждём и повторяем
            else
                return "invalid"           -- "Invalid Code!" и всё прочее
            end
        else
            task.wait(1)
        end
    end
    return "failed"
end

local codesStatus = sections.CodesR:Label({ Text = "Status: idle" })
local function setCodesStatus(t) pcall(function() codesStatus:UpdateName("Status: " .. t) end) end

-- Один проход по всем кодам. Уже отредименные пропускаем — не тратим кулдаун впустую.
-- silent = true → без уведомления (для авто-цикла, когда ничего нового нет)
local function redeemAllCodes(silent)
    if codesBusy or not ModulesLoaded then return end
    codesBusy = true

    local redeemedSet = getRedeemedSet()
    local pending = {}
    for _, code in ipairs(CODES) do
        if not redeemedSet[code] then table.insert(pending, code) end
    end

    if #pending == 0 then
        setCodesStatus(string.format("all %d codes already redeemed", #CODES))
        if not silent then Notify("Codes: all " .. #CODES .. " already redeemed") end
        codesBusy = false
        return
    end

    local got, already, bad = 0, 0, 0
    for i, code in ipairs(pending) do
        if not getgenv()._running then break end
        setCodesStatus(string.format("redeeming %s (%d/%d)", code, i, #pending))
        local res = redeemOne(code)
        if res == "redeemed" then got = got + 1
        elseif res == "already" then already = already + 1
        else bad = bad + 1 end
        if i < #pending then task.wait(CODE_COOLDOWN) end
    end

    setCodesStatus(string.format("+%d new · %d already · %d invalid", got, already, bad))
    if got > 0 or not silent then
        Notify(string.format("Codes: +%d redeemed, %d already, %d invalid", got, already, bad))
    end
    codesBusy = false
end

