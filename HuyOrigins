-- ===================== SUMMON =====================
-- Баннеры и их пулы юнитов тянем из игры: SummonFunction:InvokeServer("GetBanner").
-- Ничего не захардкожено — новый баннер/юнит подхватится сам (кнопка Refresh).
summonBanners   = {}
selectedBanner  = nil
summonAmount    = 10
summonTargets   = {}      -- set реальных имён юнитов
autoSummon      = false

local RARITY_HEX = { Rare = "#3498DB", Epic = "#9B59B6", Legendary = "#FFD700",
                     Mythic = "#ED4245", Secret = "#00FFFF", Limited = "#FF8C00" }
local RARITY_ORDER = { Secret = 1, Mythic = 2, Legendary = 3, Epic = 4, Rare = 5 }
local unitDisplayToName = {}

local function fetchBanners()
    if not R.SummonF then return {} end
    local ok, res = pcall(function() return R.SummonF:InvokeServer("GetBanner") end)
    return (ok and type(res) == "table") and res or {}
end

local function buildBannerOptions()
    local names = {}
    for key, b in pairs(summonBanners) do
        table.insert(names, { key = key, order = (type(b) == "table" and b.LayoutOrder) or 99 })
    end
    table.sort(names, function(a, b) return a.order < b.order end)
    local out = {}
    for _, n in ipairs(names) do table.insert(out, n.key) end
    return out
end

-- опции красим по рарности (MacLib рендерит их RichText) + держим обратный map display -> имя
local function buildUnitOptions(bannerKey)
    unitDisplayToName = {}
    local b = summonBanners[bannerKey]
    if type(b) ~= "table" or type(b.BannerTowers) ~= "table" then return {} end
    local rows = {}
    for rarity, list in pairs(b.BannerTowers) do
        if type(list) == "table" then
            for _, unit in pairs(list) do
                table.insert(rows, { unit = tostring(unit), rarity = tostring(rarity) })
            end
        end
    end
    table.sort(rows, function(a, b2)
        local oa, ob = RARITY_ORDER[a.rarity] or 9, RARITY_ORDER[b2.rarity] or 9
        if oa ~= ob then return oa < ob end
        return a.unit < b2.unit
    end)
    local out = {}
    for _, r in ipairs(rows) do
        local disp = string.format('<font color="%s">[%s]</font> %s',
            RARITY_HEX[r.rarity] or "#FFFFFF", r.rarity, r.unit)
        unitDisplayToName[disp] = r.unit
        table.insert(out, disp)
    end
    return out
end

local function resolveUnitName(disp)
    return unitDisplayToName[disp]
        or (tostring(disp):gsub("<[^>]->", "")):match("%]%s*(.+)$")
        or disp
end

